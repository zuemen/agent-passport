# Copy to .env and fill in. Never commit .env.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Deployer key: generate a fresh one for this project (`cast wallet new`), fund it at https://faucet.monad.xyz
DEPLOYER_PRIVATE_KEY=
# Optional: reuse existing ERC-8004 registries instead of deploying ours.
# Official ERC-8004 reference deployment on Monad testnet:
#   Identity   0x8004A818BFB912233c491871b3d84c89A494BD9e
#   Reputation 0x8004B663056A597Dffe9eCcC1965A193B7388713
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=
# Address of the off-chain vLEI verifier service allowed to record owner assurance (default: deployer)
VLEI_VERIFIER=
